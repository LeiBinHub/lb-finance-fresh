# Copy to .env and fill in. The app reads this file itself. Do not commit .env.
# A system environment variable overrides the same name in .env.

# Required. https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_MODEL=deepseek-chat
# Media articles use thinking mode. Optional model override and effort: low / high / max
# DEEPSEEK_THINK_MODEL=deepseek-chat
# DEEPSEEK_REASONING_EFFORT=high

# News, earnings calendar, and regular-session quotes. One key, no secret.
# https://finnhub.io/register
FINNHUB_API_KEY=

# 10Y / 2Y Treasury yields. One key, no secret.
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Alpha Vantage is a different site from Alpaca. It only gives you one API key.
# Free tier is about 25 requests per day, so the brief calls it once per run for news.
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Optional. Alpaca market data is not Alpha Vantage: it needs both a key id and a secret.
# They are sent as headers APCA-API-KEY-ID and APCA-API-SECRET-KEY to data.alpaca.markets.
# Do not use the Broker OAuth client-credentials flow. https://alpaca.markets/
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Regular/pre/after hours: ALPACA_FEED (default iex). Night session 20:00–04:00 ET is always fetched as overnight and spliced on.
# ALPACA_FEED=iex

# DingTalk custom robot. Turn on "sign" and paste both lines.
# https://open.dingtalk.com/document/robots/custom-robot-access
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# WeCom group robot. This is the WeChat-side webhook, same idea as DingTalk.
# https://developer.work.weixin.qq.com/document/path/91770
WECOM_WEBHOOK=

# Personal WeChat via PushPlus. https://www.pushplus.plus/
PUSHPLUS_TOKEN=

# IDE 本机启动时连本机映射的 Redis。docker compose 会覆盖成服务名 redis。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Docker / OrbStack 里由 compose 设 SERVER_ADDRESS=0.0.0.0，一般不用写进 .env
# SERVER_ADDRESS=127.0.0.1
# SERVER_PORT=8092

# Telegram API from https://my.telegram.org (api_id + api_hash). Do not commit real values.
# Enables Telegram listeners. Public pages are polled every 2 seconds.
# Channels that hide t.me/s still need a one-time Telethon user login
# (phone app login is a different session): docker compose run --rm -it telegram-listen
# @TreeNewsFeed @WalterBloomberg @jin10light @unusual_whales_TG1 @forexlive
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional comma-separated override of the watchlist in application.yml
# WATCHLIST=NVDA,AAPL,MSFT,SPY,QQQ,USO,GLD,VIX
